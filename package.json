{
  "name": "gmlrender",
  "version": "3.0.0-beta.5",
  "description": "Library for rendering GML documents.",
  "homepage": "https://github.com/dwyfl/gmlrender",
  "bugs": {
    "url": "https://github.com/dwyfl/gmlrender/issues"
  },
  "license": "MIT",
  "author": "Gustav Peterz <gpeterz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwyfl/gmlrender.git"
  },
  "bin": {
    "gmlrender": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "browser": {
    "canvas": false
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./browser": "./dist/browser.mjs",
    "./cli": "./dist/cli/index.mjs",
    "./server": "./dist/server.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "commander": "^14.0.3",
    "gl-matrix": "^3.4.4",
    "gmljs": "3.0.0-beta.1",
    "mediabunny": "^1.40.1",
    "skia-canvas": "^3.0.8",
    "wasm-webp": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260422.1",
    "bumpp": "^11.0.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.19"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "skia-canvas"
    ],
    "patchedDependencies": {
      "wasm-webp": "patches/wasm-webp.patch"
    }
  }
}
