  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "gmljs": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/pngjs": "^6.0.5",
    "bumpp": "^12.3.0",
    "canvas": "^3.2.3",
    "mediabunny": "^1.61.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "skia-canvas": "^3.0.8",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "canvas": "^3.2.3",
    "mediabunny": "^1.61.3",
    "skia-canvas": "^3.0.8"
  },
