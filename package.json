{
  "name": "gmlrender",
  "version": "3.0.0-beta-260108",
  "description": "Library for rendering GML documents.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -W",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "test:watch": "node --import tsx --test --watch 'test/**/*.test.ts'",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "prepublishOnly:": "npm run clean && npm run build"
  },
  "author": "Gustav Peterz <gpeterz@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwyfl/gmlrender.git"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "commander": "^14.0.2",
    "eventemitter3": "5.0.1",
    "gl-matrix": "^3.4.4",
    "gmljs": "latest"
  }
}
